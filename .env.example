# Postgres (infra/docker-compose.yml)
POSTGRES_USER=dnd
POSTGRES_PASSWORD=dnd
POSTGRES_DB=dnd
DATABASE_URL=postgres://dnd:dnd@127.0.0.1:5433/dnd?sslmode=disable
# Dimensión de los embeddings; solo se aplica al crear las tablas (make db-migrate)
EMBEDDING_DIM=1024

# Services (4100 and 5173 are reserved by other tools)
SERVER_PORT=4200
SERVER_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5180
MCP_PORT=4300
MCP_HOST=127.0.0.1
